#!/bin/bash
# Standards Enforcement Hook
# This file ensures DDD, SOLID, DRY, TDD compliance

echo "================================================"
echo "📋 CHECKING DEVELOPMENT STANDARDS COMPLIANCE"
echo "================================================"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check for tests
check_tests() {
    local file=$1
    local test_file=$(echo $file | sed 's/src/tests\/unit/g' | sed 's/.js/.test.js/g')
    
    if [[ ! -f "$test_file" ]]; then
        echo -e "${RED}❌ Missing test for: $file${NC}"
        echo -e "${YELLOW}   Expected: $test_file${NC}"
        return 1
    fi
    return 0
}

# Check DDD structure
check_ddd_structure() {
    local file=$1
    
    # Check if file is in correct layer
    if [[ $file == *"src/domain"* ]] && grep -q "require.*express\|mongoose" $file; then
        echo -e "${RED}❌ Domain layer violation in: $file${NC}"
        echo -e "${YELLOW}   Domain should not depend on infrastructure${NC}"
        return 1
    fi
    
    if [[ $file == *"src/presentation"* ]] && grep -q "mongoose\|MongoClient" $file; then
        echo -e "${RED}❌ Presentation layer violation in: $file${NC}"
        echo -e "${YELLOW}   Controllers should not access database directly${NC}"
        return 1
    fi
    
    return 0
}

# Check SOLID principles
check_solid() {
    local file=$1
    
    # Check for large classes (SRP violation)
    local line_count=$(wc -l < "$file")
    if [[ $line_count -gt 200 ]]; then
        echo -e "${YELLOW}⚠️  Possible SRP violation in: $file (${line_count} lines)${NC}"
    fi
    
    # Check for direct instantiation (DIP violation)
    if grep -q "new.*Service\|new.*Repository" $file 2>/dev/null; then
        if [[ ! $file == *"DIContainer"* ]] && [[ ! $file == *"test"* ]]; then
            echo -e "${YELLOW}⚠️  Possible DIP violation in: $file${NC}"
            echo -e "${YELLOW}   Use dependency injection instead of 'new'${NC}"
        fi
    fi
    
    return 0
}

# Main enforcement
FAILED=0
WARNINGS=0

echo -e "\n🔍 Checking staged files...\n"

for file in $(git diff --cached --name-only --diff-filter=ACM | grep "\.js$"); do
    if [[ $file == *"backend/src"* ]]; then
        echo "Checking: $file"
        
        # Run checks
        check_tests "$file" || FAILED=$((FAILED + 1))
        check_ddd_structure "$file" || FAILED=$((FAILED + 1))
        check_solid "$file" || WARNINGS=$((WARNINGS + 1))
    fi
done

echo ""
echo "================================================"

if [[ $FAILED -gt 0 ]]; then
    echo -e "${RED}❌ COMMIT BLOCKED: $FAILED violations found${NC}"
    echo ""
    echo "📚 Please review: DEVELOPMENT_STANDARDS.md"
    echo ""
    echo "Quick fixes:"
    echo "1. Write tests first (TDD)"
    echo "2. Follow DDD structure"
    echo "3. Apply SOLID principles"
    echo "4. Check for code duplication (DRY)"
    exit 1
fi

if [[ $WARNINGS -gt 0 ]]; then
    echo -e "${YELLOW}⚠️  $WARNINGS warnings found (commit allowed)${NC}"
fi

echo -e "${GREEN}✅ All standards checks passed!${NC}"
echo ""
echo "🎯 Standards Applied:"
echo "  • Domain-Driven Design ✓"
echo "  • SOLID Principles ✓"
echo "  • DRY (No duplication) ✓"
echo "  • Test-Driven Development ✓"
echo ""
exit 0