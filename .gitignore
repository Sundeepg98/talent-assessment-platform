# ============================================
# DOCUMENTATION RULES
# ============================================

# Temporary documentation folder
.temp-docs/

# Temporary document patterns
*.tmp.md
*.temp.md
*.draft.md
*.wip.md

# Development reports (generated during development)
# EXCEPTION: docs/archive/ contains valuable implementation history
*_REPORT.md
*_AUDIT.md
*_TEST_RESULTS.md
*_INVESTIGATION.md
*_ANALYSIS.md
*_REVIEW.md
*_VALIDATION.md
*_FIXED.md
*_ISSUE.md
*_PLAN.md

# Keep archive documentation
!docs/archive/*.md

# Test outputs
test-results/
test-reports/
e2e-reports/

# Exclude all markdown files by default in certain folders
/iterations/*.md
/drafts/*.md
/notes/*.md

# ============================================
# WHITELIST: Keep these documentation files
# ============================================
!README.md
!frontend/README.md
!backend/README.md
!tests/README.md
!docs/README.md
!docs/architecture/*.md
!docs/api/*.md
!docs/deployment/*.md
!CONTRIBUTING.md
!LICENSE.md
!CHANGELOG.md

# Misc
.cache
.parcel-cache
.turbo